# ─── Jira Configuration ───────────────────────────────────────────────────────
# Your Atlassian workspace URL (e.g. https://yourcompany.atlassian.net)
JIRA_BASE_URL=https://your-workspace.atlassian.net

# The email address linked to your Atlassian account
EMAIL=your-email@example.com

# Jira API Token — generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
API_TOKEN=your_jira_api_token_here

# ─── Gemini AI Configuration ──────────────────────────────────────────────────
# Get a free key in 30 seconds at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
